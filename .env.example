# Copy to .env and fill in. Never commit .env.

# --- MT5 broker (live/paper execution) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                              # optional, e.g. C:/Program Files/MetaTrader 5/terminal64.exe

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: Claude API for the LLM-analyst macro module ---
ANTHROPIC_API_KEY=

# --- Runtime ---
XAUUSD_BOT_CONFIG=configs/personal_aggressive.yaml
XAUUSD_BOT_ENV=dev                     # dev | paper | live
LOG_LEVEL=INFO
